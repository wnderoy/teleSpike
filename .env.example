# teleSpike — environment template. Copy to .env and fill in real values.
# The synthetic pipeline (P0-P5) needs none of these; only the Telethon
# scraper (P6) requires the TELEGRAM_* values.

# --- Telethon scraper (src/scan_telegram.py) ---
# Get these from https://my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Telegram user phone number that owns the session (interactive login).
TELEGRAM_PHONE=
# Optional: a "session name" for the .session file saved under data/.
TELEGRAM_SESSION=data/history/telegram

# --- Kafka bootstrap (override if not using docker-compose defaults) ---
# Inside the compose network the broker is kafka:29092; from the host use localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# --- Topics ---
TOPIC_TELEGRAM=telegram
TOPIC_ALERTS=alerts
